@startuml

|普通用户|
start
:浏览活动列表;
:查看活动详情;
if (是否报名?) then (是)
  :填写报名信息;
  if (需要图片?) then (是)
    :上传报名图片;
  else (否)
  endif
  :提交报名;
  :等待审核;
  while (审核是否通过?) is (否)
    :查看拒绝原因;
    :修改报名信息;
    if (需要图片?) then (是)
      :重新上传图片;
    else (否)
    endif
    :重新提交报名;
    :等待审核;
  endwhile (是)
  :报名成功;
  :活动当天;
  while (活动是否已开始?) is (否)
    :等待活动开始;
  endwhile (是)
  :进行签到;
  :签到成功;
else (否)
  :取消操作;
endif
stop
@enduml