
@startuml
skinparam component {
    BackgroundColor<<layer>> LightBlue
    BackgroundColor<<security>> LightCoral
    BackgroundColor<<data>> LightGreen
}

package "前端层" {
    [Web前端/移动端] as Frontend
}

package "应用层 (Spring Boot 3.2)" {
    
    package "表示层 Controller" {
        [认证管理] as Auth
        [活动查询] as Query
        [活动管理] as Manage
        [活动参与] as Join
        [管理员功能] as Admin
    }
    
    package "业务层 Service" {
        [业务逻辑处理] as Service
    }
    
    package "数据访问层" {
        [MyBatis Plus] as Mapper
    }
    
    package "实体层" {
        [Entity] as Entity
    }
}

package "安全层" {
    [JWT认证] as JWT
    [Spring Security] as Security
}

package "数据层" {
    [SQLite数据库] as SQLite
    [本地文件存储] as File
}

' 连接关系
Frontend --> Auth
Frontend --> Query
Frontend --> Manage
Frontend --> Join
Frontend --> Admin

Auth --> Service
Query --> Service
Manage --> Service
Join --> Service
Admin --> Service

Service --> Mapper
Mapper --> SQLite
Mapper --> Entity

Manage --> File
Join --> File

Security --> JWT

@enduml