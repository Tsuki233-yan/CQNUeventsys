@startuml

|游客|
start
:访问系统;
if (已有账号?) then (是)
  :输入用户名密码;
  while (验证是否通过?) is (否)
    :显示错误提示;
    :重新输入用户名密码;
  endwhile (是)
  :生成JWT令牌;
  :登录成功;
  :进入系统;
else (否)
  :填写注册信息;
  while (信息是否有效?) is (否)
    :显示校验错误;
    :修改注册信息;
  endwhile (是)
  :保存用户信息;
  :注册成功;
  :跳转登录页;
endif
|普通用户|
:使用系统功能;
stop
@enduml